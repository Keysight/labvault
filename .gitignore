# LabVault .gitignore — customer SKU (Keysight GitHub)

# Secrets & local env
.env
.env.*
!.env.example
secrets/
*.pem
*.key

# Local databases & media
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
hyperview_db.sqlite3
db.sqlite3
np_timeseries.sqlite3
media/
staticfiles/
local_static/
var/
data/lldp_persistent_cache.json

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Tests / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Build artifacts
dist/
build/
wheelhouse/

# Backups / dumps (never commit lab data)
*.tgz
*.tar.gz
*.bin
*.sql
*.dump
labvault_export.json
labvault_export.bin
**/bootstrap-credentials
**/fleet-token

# IDE / OS
.cursor/
!.cursor/rules/
!.cursor/rules/*.mdc
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Agent / local research
agent-research/outputs/
agent-research/graph/
agent-research/index/
graphify-out/
.context/
.cache/

# Logs
*.log
npm-debug.log*

# Docker local overrides
docker-compose.override.yml
