# LabVault — generated by deploy/scripts/install-labvault-nginx.sh
# Host: @@LABVAULT_SERVER_NAME@@
# Gunicorn upstream: 127.0.0.1:8000 | TLS: @@LABVAULT_SSL_CERT@@

upstream labvault_app {
    server 127.0.0.1:8000;
    keepalive 16;
}

server {
    listen 80;
    server_name @@LABVAULT_SERVER_NAME@@;
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name @@LABVAULT_SERVER_NAME@@;

    ssl_certificate     @@LABVAULT_SSL_CERT@@;
    ssl_certificate_key @@LABVAULT_SSL_KEY@@;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:LABVAULT_SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 5g;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types text/plain text/css application/json application/javascript text/javascript application/xml;

    location /static/ {
        alias /opt/labvault/current/staticfiles/;
        expires 7d;
        add_header Cache-Control "public";
    }

    location /media/ {
        alias /var/lib/labvault/media/;
        expires 1d;
    }

    location / {
        proxy_pass http://labvault_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header Connection "";
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}
