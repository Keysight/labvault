[Unit]
Description=LabVault privileged operations broker (opsd)
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/labvault/current
EnvironmentFile=-/etc/labvault/labvault.env
Environment=LABVAULT_OPS_SOCK=/run/labvault/ops.sock
Environment=LABVAULT_OPS_ADAPTER=auto
Environment=LABVAULT_COMPOSE_PROJECT_DIR=/opt/labvault/current
Environment=LABVAULT_COMPOSE_FILE=deploy/compose/docker-compose.yml
RuntimeDirectory=labvault
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3
StartLimitBurst=5
# Prefer venv Python (systemd/airgap); fall back to system python3 (Compose host).
ExecStart=/bin/bash -c 'ROOT=/opt/labvault/current; if [ -x "$ROOT/.venv/bin/python" ]; then exec "$ROOT/.venv/bin/python" "$ROOT/opsd/opsd.py" --sock /run/labvault/ops.sock; else exec /usr/bin/python3 "$ROOT/opsd/opsd.py" --sock /run/labvault/ops.sock; fi'
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
# Legacy Compose unit name — same broker everywhere.
Alias=labvault-opsd-compose.service
